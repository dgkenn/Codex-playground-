# Paste these into the environment's "Environment variables" field (.env format,
# one KEY=value per line, NO quotes). Use SHORT-LIVED, READ-ONLY STS credentials
# scoped to the BDSP access point -- not long-lived root keys. NOTE: there is no
# secrets store; these are visible to anyone who can edit the environment. Rotate
# after the pilot.
AWS_ACCESS_KEY_ID=ASIA....your_temp_key....
AWS_SECRET_ACCESS_KEY=....your_temp_secret....
AWS_SESSION_TOKEN=....your_session_token....
AWS_DEFAULT_REGION=us-east-1
