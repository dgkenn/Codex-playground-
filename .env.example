# Copy to .env (gitignored). chmod 600 .env. NEVER commit real values.
#
# NOTE: keep values on their own line with NO inline comment -- systemd's EnvironmentFile= does NOT
# strip trailing comments, so `I_UNDERSTAND_REAL_MONEY=yes  # armed` would silently stay DRY-RUN
# under systemd while arming under run.sh's shell sourcing.

# --- LIVE trading (only needed for live_trader.py --live) ---
PRIVATE_KEY=0xYOUR_BURNER_WALLET_PRIVATE_KEY
DEPOSIT_WALLET_ADDRESS=0xYOUR_POLYMARKET_DEPOSIT_WALLET

# Must match HOW the Polymarket account was created, or every order fails signature validation:
#   POLY_PROXY       email/Magic-link login (the GO_LIVE.md default path)
#   POLY_GNOSIS_SAFE browser-wallet (MetaMask etc.) login
#   EOA              trading directly from the private key's own address
#   POLY_1271        other smart-contract wallets/vaults
SIGNATURE_TYPE=POLY_PROXY

# set to 'yes' (exactly, nothing after it) only to arm real orders
I_UNDERSTAND_REAL_MONEY=no

# --- Telegram alerts (optional, free) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
